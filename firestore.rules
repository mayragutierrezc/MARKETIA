rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAuthenticated();
      allow delete: if false;
    }

    // Businesses
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Strategies
    match /strategies/{strategyId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Global pricing configuration
    match /pricing_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
